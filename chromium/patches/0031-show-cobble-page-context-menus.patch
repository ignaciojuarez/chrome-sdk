+// Cobble hosts pages in its own AppKit windows, which have no views::Widget.
+// Matches views::MenuControllerParamsForWidget() with the page's colors.
+remote_cocoa::mojom::MenuControllerParamsPtr CobbleMenuControllerParams(
+    const ui::ColorProvider& color_provider) {
+  auto params = remote_cocoa::mojom::MenuControllerParams::New();
+  params->badge_font =
+      views::BadgePainter::GetBadgeFont(views::MenuConfig::instance().font_list)
+          .GetPrimaryFont();
+  params->badge_color =
+      color_provider.GetColor(ui::kColorBadgeInCocoaMenuBackground);
+  params->badge_text_color =
+      color_provider.GetColor(ui::kColorBadgeInCocoaMenuForeground);
+  params->badge_horizontal_margin = views::BadgePainter::kBadgeHorizontalMargin;
+  params->badge_internal_padding = views::BadgePainter::kBadgeInternalPadding;
+  params->badge_min_height = views::BadgePainter::kBadgeMinHeightCocoa;
+  params->badge_radius = base::checked_cast<uint32_t>(
+      views::LayoutProvider::Get()->GetCornerRadiusMetric(
+          views::ShapeContextTokens::kBadgeRadius));
+  params->iph_dot_color =
+      color_provider.GetColor(ui::kColorButtonBackgroundProminent);
+  return params;
+}
+
+// Removes top-level commands Cobble does not host and the separators they
+// leave at either end or next to each other.
+void RemoveCobbleHiddenItems(ui::SimpleMenuModel& model,
+                             content::WebContents* contents) {
+  for (size_t index = model.GetItemCount(); index > 0; --index) {
+    if (cobble_chromium::HidesContextMenuCommand(
+            model.GetCommandIdAt(index - 1), contents)) {
+      model.RemoveItemAt(index - 1);
+    }
+  }
+  bool after_separator = true;
+  for (size_t index = 0; index < model.GetItemCount();) {
+    const bool separator =
+        model.GetTypeAt(index) == ui::MenuModel::TYPE_SEPARATOR;
+    if (separator && after_separator) {
+      model.RemoveItemAt(index);
+      continue;
+    }
+    after_separator = separator;
+    ++index;
+  }
+  if (after_separator && model.GetItemCount() > 0) {
+    model.RemoveItemAt(model.GetItemCount() - 1);
+  }
+}
+

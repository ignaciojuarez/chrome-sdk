 namespace predictors {
 
 bool IsLoadingPredictorEnabled(Profile* profile) {
+#if BUILDFLAG(IS_MAC)
+  // Cobble disables Chromium history; the predictor would still persist
+  // visited hosts and their resources.
+  if (cobble_chromium::IsEnabled()) {
+    return false;
+  }
+#endif
   // Disabled for off-the-record. Policy choice, not a technical limitation.
   return profile && !profile->IsOffTheRecord();
 }

+#if BUILDFLAG(IS_MAC)
+namespace {
+
+class CobblePostReloadNavigationThrottle final
+    : public content::NavigationThrottle {
+ public:
+  explicit CobblePostReloadNavigationThrottle(
+      content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+
+  ~CobblePostReloadNavigationThrottle() override {
+    weak_factory_.InvalidateWeakPtrs();
+    if (prompt_id_) {
+      cobble_chromium::CancelFormRepostConfirmation(prompt_id_);
+    }
+  }
+
+  ThrottleCheckResult WillStartRequest() override {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&CobblePostReloadNavigationThrottle::BeginPrompt,
+                       weak_factory_.GetWeakPtr()));
+    return DEFER;
+  }
+
+  const char* GetNameForLogging() override {
+    return "CobblePostReloadNavigationThrottle";
+  }
+
+ private:
+  void BeginPrompt() {
+    content::WebContents* contents = navigation_handle()->GetWebContents();
+    content::RenderFrameHost* frame = content::RenderFrameHost::FromID(
+        navigation_handle()->GetPreviousRenderFrameHostId());
+    if (!cobble_chromium::PageForWebContents(contents) || !frame ||
+        content::WebContents::FromRenderFrameHost(frame) != contents) {
+      CancelDeferredNavigation(CANCEL_AND_IGNORE);
+      return;
+    }
+    base::WeakPtr<CobblePostReloadNavigationThrottle> alive =
+        weak_factory_.GetWeakPtr();
+    const uint64_t prompt_id =
+        cobble_chromium::RequestFormRepostConfirmation(
+            contents, frame,
+            base::BindOnce(&CobblePostReloadNavigationThrottle::FinishPrompt,
+                           weak_factory_.GetWeakPtr()));
+    if (alive) {
+      prompt_id_ = prompt_id;
+    }
+  }
+
+  void FinishPrompt(bool accept) {
+    prompt_id_ = 0;
+    if (accept) {
+      Resume();
+    } else {
+      CancelDeferredNavigation(CANCEL_AND_IGNORE);
+    }
+  }
+
+  uint64_t prompt_id_ = 0;
+  base::WeakPtrFactory<CobblePostReloadNavigationThrottle> weak_factory_{this};
+};
+
+}  // namespace
+#endif
+
 void ChromeContentBrowserClient::CreateThrottlesForNavigation(
     content::NavigationThrottleRegistry& registry) {
   CreateAndAddChromeThrottlesForNavigation(registry);
+#if BUILDFLAG(IS_MAC)
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (cobble_chromium::PageForWebContents(handle.GetWebContents()) &&
+      handle.IsPost() && handle.GetReloadType() != content::ReloadType::NONE) {
+    registry.AddThrottle(
+        std::make_unique<CobblePostReloadNavigationThrottle>(registry));
+  }
+#endif
 }
 

+  if (cobble_chromium::PageForWebContents(source)) {
+    content::NavigationController& controller = source->GetController();
+    content::NavigationEntry* entry = controller.GetLastCommittedEntry();
+    content::RenderFrameHost* frame = source->GetPrimaryMainFrame();
+    if (!entry || !frame) {
+      controller.CancelPendingReload();
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<content::WebContents> contents, int entry_id,
+               content::WeakDocumentPtr document) {
+              if (!contents) {
+                return;
+              }
+              content::NavigationController& controller =
+                  contents->GetController();
+              content::NavigationEntry* current =
+                  controller.GetLastCommittedEntry();
+              content::RenderFrameHost* frame =
+                  contents->GetPrimaryMainFrame();
+              CCSPageRef page =
+                  cobble_chromium::PageForWebContents(contents.get());
+              if (cobble_chromium::IsStopping() || !page || !current ||
+                  current->GetUniqueID() != entry_id || !frame ||
+                  document.AsRenderFrameHostIfValid() != frame ||
+                  controller.GetPendingEntry() ||
+                  cobble_chromium::PageHasPendingPromptOrMedia(page)) {
+                controller.CancelPendingReload();
+                return;
+              }
+              controller.ContinuePendingReload();
+            },
+            source->GetWeakPtr(), entry->GetUniqueID(),
+            frame->GetWeakDocumentPtr()));
+    return;
+  }
+#endif
   TabModalConfirmDialog::Create(
       std::make_unique<RepostFormWarningController>(source), source);
 }

+std::string HostBundleKeychainName(bool service_name) {
+  // chrome_main_mac sets BaseBundleID() from the outer application bundle
+  // before browser-process services start. Scope OSCrypt to that stable host
+  // identity so an embedded unbranded build never reads Chromium's key.
+  std::string_view bundle_id = base::apple::BaseBundleID();
+  if (bundle_id.empty()) {
+    bundle_id = "com.ignacio.cobble.chromium-sdk";
+  }
+  return service_name ? base::StrCat({bundle_id, " Safe Storage"})
+                      : std::string(bundle_id);
+}
 

+#if BUILDFLAG(IS_MAC)
+[[noreturn]] void CobbleClientFatalError(const char* message,
+                                         const char* detail) {
+  UNSAFE_TODO(fprintf(stderr, "%s%s\n", message, detail ? detail : ""));
+  abort();
+}
+
+// Load the SDK client from the outer app bundle before ChromeMain starts the
+// browser process. Helpers (any `--type=` process) continue directly into
+// ContentMain after their normal Seatbelt bootstrap. The client receives the
+// already loaded framework handle and resolves only its exported symbols.
+void LoadCobbleClient(int argc, const char** argv) {
+  for (int i = 1; i < argc; ++i) {
+    if (UNSAFE_TODO(strncmp(argv[i], "--type=", 7)) == 0) {
+      return;
+    }
+  }
+  char exec_path[PATH_MAX];
+  uint32_t exec_path_size = sizeof(exec_path);
+  if (_NSGetExecutablePath(exec_path, &exec_path_size) != 0) {
+    CobbleClientFatalError("_NSGetExecutablePath failed", nullptr);
+  }
+  const char* parent_dir = dirname(exec_path);
+  if (!parent_dir) {
+    CobbleClientFatalError("dirname failed", nullptr);
+  }
+  const std::string client_path =
+      std::string(parent_dir) + "/../Frameworks/CobbleChromiumClient.dylib";
+  if (access(client_path.c_str(), R_OK) != 0) {
+    CobbleClientFatalError(
+        "This SDK runtime requires an assembled native client before "
+        "launching.",
+        nullptr);
+  }
+  Dl_info framework_info;
+  if (!dladdr(reinterpret_cast<const void*>(&LoadCobbleClient),
+              &framework_info) ||
+      !framework_info.dli_fname) {
+    CobbleClientFatalError("dladdr failed for the Chromium framework", nullptr);
+  }
+  void* framework = dlopen(framework_info.dli_fname, RTLD_LAZY | RTLD_NOLOAD);
+  if (!framework) {
+    CobbleClientFatalError("dlopen framework: ", dlerror());
+  }
+  void* client = dlopen(client_path.c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (!client) {
+    CobbleClientFatalError("dlopen CobbleChromiumClient.dylib: ", dlerror());
+  }
+  using CCSClientMainPtr = int (*)(void* chromium_framework_handle);
+  const CCSClientMainPtr client_main =
+      reinterpret_cast<CCSClientMainPtr>(dlsym(client, "CCSClientMain"));
+  if (!client_main) {
+    CobbleClientFatalError("dlsym CCSClientMain: ", dlerror());
+  }
+  if (client_main(framework) != 0) {
+    CobbleClientFatalError("CCSClientMain failed", nullptr);
+  }
+}
+#endif  // BUILDFLAG(IS_MAC)
+
 }  // namespace
 
 const base::CommandLine& GetInitialBrowserCommandLine() {

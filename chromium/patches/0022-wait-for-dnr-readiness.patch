+void RulesMonitorService::WaitForInitialRulesetsInternal(
+    const ExtensionId& extension_id,
+    ApiCallback callback) {
+  if (!extension_registry_->enabled_extensions().Contains(extension_id)) {
+    std::move(callback).Run(
+        "The extension was unloaded before its rules became ready.");
+    return;
+  }
+  if (initial_ruleset_load_failures_.contains(extension_id)) {
+    std::move(callback).Run(
+        "One or more declarative rulesets failed to load.");
+    return;
+  }
+  std::move(callback).Run(std::nullopt);
+}

+void CreateFileURLLoaderFromFile(
+    const network::ResourceRequest& request,
+    base::File file,
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    std::unique_ptr<FileURLLoaderObserver> observer) {
+  if (!file.IsValid() || !request.url.SchemeIsFile()) {
+    mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+        ->OnComplete(network::URLLoaderCompletionStatus(net::ERR_INVALID_ARGUMENT));
+    return;
+  }
+  auto task_runner = base::ThreadPool::CreateSequencedTaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+  task_runner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&FileURLLoader::CreateAndStart, base::FilePath(), request,
+                     network::mojom::FetchResponseType::kBasic,
+                     std::move(loader), std::move(client),
+                     DirectoryLoadingPolicy::kFail,
+                     FileAccessPolicy::kUnrestricted,
+                     LinkFollowingPolicy::kDoNotFollow, std::move(observer),
+                     nullptr, std::move(file),
+                     file_access::ScopedFileAccess::Allowed()));
+}

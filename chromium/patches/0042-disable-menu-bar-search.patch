 void ChromeFeatureListCreator::SetUpFieldTrials() {
+#if BUILDFLAG(IS_MAC)
+  if (cobble_chromium::IsEnabled()) {
+    // Cobble has no system-wide search launcher. Keep Chromium's menu bar
+    // search item and its global shortcut off even when a field trial or the
+    // testing config enables them. Command-line overrides win over both.
+    auto* command_line = base::CommandLine::ForCurrentProcess();
+    std::string disabled =
+        command_line->GetSwitchValueASCII(switches::kDisableFeatures);
+    if (!disabled.empty()) {
+      disabled.push_back(',');
+    }
+    disabled.append("OmniboxEverywhere");
+    command_line->AppendSwitchASCII(switches::kDisableFeatures, disabled);
+  }
+#endif
   browser_field_trials_ =
       std::make_unique<ChromeBrowserFieldTrials>(local_state_.get());
 
